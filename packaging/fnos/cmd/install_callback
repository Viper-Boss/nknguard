#!/bin/sh
set -eu

fail() {
  printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
  exit 1
}

[ "$(id -u)" -eq 0 ] || fail '安装回调没有 root 权限，无法初始化 WireGuard 服务。'
bin="${TRIM_APPDEST:?}/bin/nknguard"
cfg="${TRIM_PKGETC:?}/config.yaml"
data="${TRIM_PKGVAR:?}"
[ -x "$bin" ] || fail '应用包内缺少对应架构的 NKNGuard 可执行文件。'
install -d -m 0700 "$TRIM_PKGETC" "$data" "$data/state" "$data/run"
if [ ! -e "$cfg" ]; then
  [ -n "${wizard_dashboard_password:-}" ] || fail '请在安装向导中设置管理密码。'
  [ "$wizard_dashboard_password" = "${wizard_dashboard_password_confirm:-}" ] || fail '两次输入的管理密码不一致。'
  password="$wizard_dashboard_password"
  unset wizard_dashboard_password wizard_dashboard_password_confirm
  umask 077
  printf '%s\n' "$password" | "$bin" --config "$cfg" --state-dir "$data/state" --socket "$data/run/nknguard.sock" init --name nas-home --dashboard-password-stdin > "$TRIM_PKGETC/setup.txt" || fail '初始网络创建失败，请检查密码长度（12 个字符以上，72 字节以内）。'
  unset password
  chmod 0600 "$TRIM_PKGETC/setup.txt"
fi
exit 0
