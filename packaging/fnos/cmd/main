#!/bin/sh
set -eu

bin="${TRIM_APPDEST:?}/bin/nknguard"
cfg="${TRIM_PKGETC:?}/config.yaml"
data="${TRIM_PKGVAR:?}"
pidfile="$data/daemon.pid"
logfile="$data/daemon.log"

running() {
  [ -s "$pidfile" ] || return 1
  pid=$(cat "$pidfile")
  case "$pid" in *[!0-9]*|'') return 1;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  timeout 5s "$bin" --config "$cfg" status >/dev/null 2>&1
}

start() {
  [ "$(id -u)" -eq 0 ] || return 1
  [ -x "$bin" ] && [ -f "$cfg" ] || return 1
  if running; then return 0; fi
  install -d -m 0700 "$data" "$data/run"
  nohup "$bin" --config "$cfg" up >> "$logfile" 2>&1 &
  pid=$!
  printf '%s\n' "$pid" > "$pidfile"
  count=0
  while [ "$count" -lt 20 ]; do
    if running; then return 0; fi
    if ! kill -0 "$pid" 2>/dev/null; then break; fi
    sleep 1
    count=$((count + 1))
  done
  kill -TERM "$pid" 2>/dev/null || true
  sleep 1
  rm -f "$pidfile"
  tail -n 8 "$logfile" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}" || true
  return 1
}

stop() {
  timeout 8s "$bin" --config "$cfg" down >/dev/null 2>&1 || true
  if [ ! -s "$pidfile" ]; then return 0; fi
  pid=$(cat "$pidfile")
  case "$pid" in *[!0-9]*|'') return 1;; esac
  count=0
  while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 20 ]; do
    sleep 1
    count=$((count + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid" 2>/dev/null || true
    sleep 2
  fi
  if kill -0 "$pid" 2>/dev/null; then return 1; fi
  rm -f "$pidfile"
  return 0
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  status) if running; then exit 0; else exit 3; fi ;;
  *) exit 1 ;;
esac
