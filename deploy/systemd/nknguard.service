[Unit]
Description=NKNGuard serverless WireGuard mesh
Documentation=https://github.com/Viper-Boss/nknguard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nknguard --config /etc/nknguard/config.yaml daemon
ExecStop=/usr/local/bin/nknguard --config /etc/nknguard/config.yaml down
Restart=on-failure
RestartSec=5s
# The daemon creates a network interface and binds UDP; it needs these and
# nothing else.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/nknguard /run/nknguard /etc/nknguard
RuntimeDirectory=nknguard
RuntimeDirectoryMode=0750
StateDirectory=nknguard
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
